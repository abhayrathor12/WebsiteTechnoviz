{
  "trailingSlash": false,
  "redirects": [
    { "source": "/about-technoviz-automation-solution", "destination": "/company", "permanent": true },
    { "source": "/industrial-communication-solution", "destination": "/services/industrial-communication", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://websitebackend.pythonanywhere.com/sitemap.xml" },
    { "source": "/(.*)", "destination": "/api/render?path=$1" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}